{
  "name": "dsh-feiyu-wardrobe",
  "version": "0.4.0",
  "description": "大肥鱼衣橱 — DSH 插件：token 花销变鱼粮，侧边栏内置「换装间」分层换装小游戏（高清立绘 + 8 套大裙子 + 外套/头饰/背景/特效），悬浮小鲸鱼陪聊，纯本地离线可用；另含 21 件原创 SVG 单品与报告卡出图",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "import": "./lib/index.js"
    },
    "./catalog": "./lib/catalog.js",
    "./render": "./lib/render.js",
    "./client": "./lib/client.js"
  },
  "bin": {
    "dsh-feiyu-report": "./bin/feiyu-report.mjs"
  },
  "files": [
    "lib",
    "docs/dress-up",
    "bin",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/preview",
    "screenshots.json",
    "docs/preview/fish-demo.png"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run typecheck && npm test",
    "prepublishOnly": "npm run verify",
    "preview": "node scripts/preview.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dress-up",
    "wardrobe",
    "换装",
    "大肥鱼",
    "mini-game"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.1.0",
      "dshReleases": {
        "0.2.1-rc.2": "compatible"
      }
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  },
  "author": "GIT121995",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GIT121995/dsh-feiyu-wardrobe.git"
  },
  "homepage": "https://github.com/GIT121995/dsh-feiyu-wardrobe#readme",
  "bugs": {
    "url": "https://github.com/GIT121995/dsh-feiyu-wardrobe/issues"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2"
  }
}
